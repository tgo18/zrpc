    <dependencies>
        <dependency>
            <groupId>com.github.tgo18</groupId>
            <artifactId>zrpc-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.tgo18</groupId>
            <artifactId>zrpc-codec</artifactId>
        </dependency>
